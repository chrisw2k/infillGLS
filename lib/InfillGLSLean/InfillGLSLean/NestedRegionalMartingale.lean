module

public import InfillGLSLean.NestedRegionalAveraging
public import Mathlib.Probability.Martingale.Convergence

public section

/-!
# L2 convergence for nested regional averages

This module gives a carefully delimited nested-partition version of the
regional-averaging convergence step.  A filtration represents an increasing
sequence of regional sigma algebras.  Mathlib's L1 martingale convergence
gives almost-everywhere convergence to conditional expectation on their
supremum.  Vitali's theorem upgrades that convergence to L2 when the sequence
of conditional expectations is explicitly uniformly integrable in L2.

The manuscript allows nonnested geographic partitions and assumes a separate
refinement-in-measure condition.  Neither is constructed or implied here.
-/

namespace InfillGLSLean

open Filter MeasureTheory Topology

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-- Along a nested sequence of regional sigma algebras, conditional regional
averages converge in L2 to the conditional expectation onto the sigma algebra
generated by all resolutions, provided this L2 family is uniformly
integrable. -/
theorem nestedRegionalAverage_tendsto_eLpNorm_two_of_uniformIntegrable
    [IsFiniteMeasure μ] (ℱ : Filtration ℕ m0) (f : Ω → ℝ)
    (hlimit : MemLp (μ[f | ⨆ n, ℱ n]) 2 μ)
    (hUI : UnifIntegrable (fun n => μ[f | ℱ n]) 2 μ) :
    Tendsto (fun n => eLpNorm (μ[f | ℱ n] - μ[f | ⨆ k, ℱ k]) 2 μ)
      atTop (nhds 0) := by
  exact tendsto_Lp_finite_of_tendsto_ae (p := 2) (by norm_num)
    (by norm_num)
    (fun n => (stronglyMeasurable_condExp.mono (ℱ.le n)).aestronglyMeasurable)
    hlimit hUI (tendsto_ae_condExp (ℱ := ℱ) (μ := μ) f)

/-- If the target function is measurable for the sigma algebra generated by a
nested regional sequence, the preceding theorem specializes to convergence
directly to that function. -/
theorem nestedRegionalAverage_tendsto_eLpNorm_two_to_target
    [IsFiniteMeasure μ] (ℱ : Filtration ℕ m0) (f : Ω → ℝ)
    (hf_meas : StronglyMeasurable[⨆ n, ℱ n] f)
    (hf_int : Integrable f μ)
    (hf_L2 : MemLp f 2 μ)
    (hUI : UnifIntegrable (fun n => μ[f | ℱ n]) 2 μ) :
    Tendsto (fun n => eLpNorm (μ[f | ℱ n] - f) 2 μ) atTop (nhds 0) := by
  have hsup : (⨆ n, ℱ n) ≤ m0 := iSup_le fun n => ℱ.le n
  have hlimit_eq : μ[f | ⨆ n, ℱ n] = f :=
    condExp_of_stronglyMeasurable hsup hf_meas hf_int
  have hconv :=
    nestedRegionalAverage_tendsto_eLpNorm_two_of_uniformIntegrable ℱ f
      (by simpa [hlimit_eq] using hf_L2) hUI
  simpa [hlimit_eq] using hconv

end InfillGLSLean
