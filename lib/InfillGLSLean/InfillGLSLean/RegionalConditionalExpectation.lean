module

public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real

public section

/-!
# Measure-theoretic regional averaging as conditional expectation

Regional averages over a measurable partition are represented abstractly by
conditional expectation onto the sigma algebra generated by that partition.
This module records the L2 contraction supplied by Mathlib.  It is a genuine
measure-theoretic counterpart of finite equal-weight averaging, but it does
not yet construct the paper's nonnested sequence of geographic partitions or
prove its approximation-to-identity condition.
-/

namespace InfillGLSLean

open MeasureTheory

variable {Ω : Type*} {m m0 : MeasurableSpace Ω} {μ : Measure Ω}

/-- Conditional expectation, hence abstract regional averaging, is an L2
contraction. -/
theorem regionalAverage_eLpNorm_two_le (f : Ω → ℝ) :
    eLpNorm (μ[f | m]) 2 μ ≤ eLpNorm f 2 μ := by
  exact eLpNorm_condExp_le_eLpNorm f (by norm_num)

/-- Centering at a constant commutes with measure-theoretic regional
averaging, and the resulting squared-error L2 seminorm cannot increase. -/
theorem regionalAverage_centered_eLpNorm_two_le [IsFiniteMeasure μ]
    (hm : m ≤ m0) {f : Ω → ℝ} (hf : MemLp f 2 μ) (target : ℝ) :
    eLpNorm (fun ω => μ[f | m] ω - target) 2 μ ≤
      eLpNorm (fun ω => f ω - target) 2 μ := by
  have hf_int : Integrable f μ := hf.integrable (by norm_num)
  have hpointwise : (fun ω => f ω - target) = f - fun _ : Ω => target := by
    rfl
  have hsub :
      μ[(fun ω => f ω - target) | m] =ᵐ[μ]
        μ[f | m] - μ[(fun _ : Ω => target) | m] := by
    rw [hpointwise]
    exact condExp_sub hf_int (integrable_const target) m
  have hcenter :
      μ[(fun ω => f ω - target) | m] =ᵐ[μ]
        (fun ω => μ[f | m] ω - target) := by
    calc
      μ[(fun ω => f ω - target) | m] =ᵐ[μ]
          μ[f | m] - μ[(fun _ : Ω => target) | m] := hsub
      _ =ᵐ[μ] (fun ω => μ[f | m] ω - target) := by
        rw [condExp_const hm target]
        rfl
  calc
    eLpNorm (fun ω => μ[f | m] ω - target) 2 μ =
        eLpNorm μ[(fun ω => f ω - target) | m] 2 μ :=
      eLpNorm_congr_ae hcenter.symm
    _ ≤ eLpNorm (fun ω => f ω - target) 2 μ :=
      eLpNorm_condExp_le_eLpNorm _ (by norm_num)

/-- The same centered regional-averaging contraction in the paper's
squared-integral form. -/
theorem regionalAverage_centered_sq_integral_le [IsFiniteMeasure μ]
    (hm : m ≤ m0) {f : Ω → ℝ} (hf : MemLp f 2 μ) (target : ℝ) :
    (∫ ω, (μ[f | m] ω - target) ^ 2 ∂μ) ≤
      ∫ ω, (f ω - target) ^ 2 ∂μ := by
  let g : Ω → ℝ := fun ω => f ω - target
  have hg : MemLp g 2 μ := hf.sub (memLp_const target)
  have hg_int : Integrable (fun ω => ‖g ω‖ ^ (2 : ℝ)) μ := by
    simpa [Real.rpow_two, Real.norm_eq_abs, sq_abs] using hg.integrable_sq
  have hsub : μ[g | m] =ᵐ[μ] μ[f | m] - μ[(fun _ : Ω => target) | m] := by
    have hg_eq : g = f - fun _ : Ω => target := by
      rfl
    rw [hg_eq]
    exact condExp_sub (hf.integrable (by norm_num)) (integrable_const target) m
  have hcenter : μ[g | m] =ᵐ[μ] (fun ω => μ[f | m] ω - target) := by
    calc
      μ[g | m] =ᵐ[μ] μ[f | m] - μ[(fun _ : Ω => target) | m] := hsub
      _ =ᵐ[μ] (fun ω => μ[f | m] ω - target) := by
        rw [condExp_const hm target]
        rfl
  have hcontract :=
    integral_norm_condExp_rpow_le (μ := μ) (m := m) (p := (2 : ℝ))
      (by norm_num) hg_int
  have hcontract_sq :
      (∫ ω, (μ[g | m] ω) ^ 2 ∂μ) ≤ ∫ ω, (g ω) ^ 2 ∂μ := by
    simpa [Real.rpow_two, Real.norm_eq_abs, sq_abs] using hcontract
  calc
    (∫ ω, (μ[f | m] ω - target) ^ 2 ∂μ) =
        ∫ ω, (μ[g | m] ω) ^ 2 ∂μ := by
      apply integral_congr_ae
      filter_upwards [hcenter] with ω hω
      rw [hω]
    _ ≤ ∫ ω, (g ω) ^ 2 ∂μ := hcontract_sq
    _ = ∫ ω, (f ω - target) ^ 2 ∂μ := rfl

/-- A function already measurable at the regional resolution is unchanged by
regional averaging. -/
theorem regionalAverage_fixed [IsFiniteMeasure μ] (hm : m ≤ m0)
    {f : Ω → ℝ} (hf : StronglyMeasurable[m] f) (hf_int : Integrable f μ) :
    μ[f | m] = f :=
  condExp_of_stronglyMeasurable hm hf hf_int

/-- Re-applying the same regional-average operator changes nothing. -/
theorem regionalAverage_idempotent [IsFiniteMeasure μ] (hm : m ≤ m0)
    (f : Ω → ℝ) :
    μ[μ[f | m] | m] = μ[f | m] :=
  condExp_of_stronglyMeasurable hm stronglyMeasurable_condExp integrable_condExp

end InfillGLSLean
